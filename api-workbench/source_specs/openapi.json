  "info": {
    "title": "Incoming webhooks",
    "description": " It provides the capability to a partner for publishing event notifications from partner application to U.S. Bank",
    "termsOfService": "https://developer.usbank.com/terms",
    "contact": {
      "url": "https://developer.usbank.com/support/create"
    },
    "license": {
      "name": "U.S. Bank Operating Rules",
