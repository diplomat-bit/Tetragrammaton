        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code to trace error condition back to log information\n|code  | message | \n|:---|:---|\n|401|Invalid API keys|\n|401|Access token expired|\n|403|Forbidden|\n|404|Resource not found|\n|405|Method not allowed|\n|500|Internal server error|\n|503|Service temporarily unavailable|\n"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Errors_details": {
        "required": [
          "attributeName",
          "reason",
          "reasonCode"
        ],
        "properties": {
          "attributeName": {
            "type": "string",
            "description": "Field that caused the identified error. Used when  caused by validation errors."
          },
          "attributeValue": {
            "type": "string",
            "description": "Description of why the field caused an error. Used when caused by validation errors."
          },
          "reason": {
            "type": "string",
            "description": "As end user displayable information, this human readable text provides a high-level categorization of the occurred error. Used when caused by validation errors."
          },
          "reasonCode": {
            "type": "string",
            "description": "Description of why the field caused an error. Used when caused by validation errors.\n\nHTTP Status Code |Reason|Reason Code|\n|:---|:---|:---|\n|400|Required header is not passed in the request. |4106 |400|Invalid header is passed in the request. |4110\n"
          }
        }
      },
      "Errors_Errors": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Long-term persistent identifier, which can be used to trace the error condition back to log information. \n\nIt will represent the HTTP code and Proxy ID. \nfor instance: 400.5290\n"
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for the customer.\n",
            "example": "null"
          },
          "message": {
            "type": "string",
            "description": "As end user displayable information, this human readable text\nprovides a high-level categorization of the occurred error.\n"
          },
          "help": {
            "type": "string",
            "description": "Optional hyperlink to online support page",
            "example": "https://developer.usbank.com/support"
          },
          "details": {
            "type": "array",
            "description": "An array of detail objects contains the specific reason why the error occurred. Detail objects must contain attributeName AND attributeValue.",
            "items": {
              "$ref": "#/components/schemas/Errors_details"
            }
          }
        }
      }
    },
