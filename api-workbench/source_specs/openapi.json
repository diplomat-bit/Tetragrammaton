      "url": "https://api2.usbank.com/event-notifications/webhook/v1",
      "description": "Production URL"
    },
    {
      "url": "https://alpha-api2.usbank.com/event-notifications/webhook/v1",
      "description": "UAT URL"
    }
  ],
  "security": [
