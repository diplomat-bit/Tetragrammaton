  "paths": {
    "/events": {
      "post": {
        "tags": [
          "Publish Event Notifications"
        ],
        "summary": "Event notifications from Partners.",
        "description": "It provides the capability to a partner for publishing event notifications from partner application to U.S.Bank.\nIncoming Webhooks offer an easy and direct way to communicate real-time information to U.S. Bank from third-party applications. This simplifies the process of sending real-time notifications from external applications directly to U.S. Bank.",
        "operationId": "publish-Events",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "OAuth Bearer Token",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Correlation-ID",
            "in": "header",
            "description": "Unique identifier for every request-response pair. Allows to trace full path of interactions through multiple sub-systems.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "description": "Indicates request payload format of 'application/json'.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "example": "application/json"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "description": "Indicates the acceptable response format. Recommended to use application/json.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Correlation-ID": {
                "$ref": "#/components/headers/Correlation-ID"
              },
              "Content-Type": {
                "$ref": "#/components/headers/Content-Type"
              },
              "Date": {
                "$ref": "#/components/headers/Date"
              },
              "Version": {
                "$ref": "#/components/headers/Version"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "429": {
