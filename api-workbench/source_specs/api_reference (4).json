    "/travelnotificationservice/v1/travelnotification/retrievetravel": {
      "post": {
        "tags": [
          "Visa Travel Notification API"
        ],
        "summary": "Retrieve Travel Itinerary",
        "description": "Retrieve Travel Itinerary API allows you to request details of travel itineraries you previously sent to Visa. A successful response includes the list of travel itineraries that match your request.",
        "operationId": "Retrieve Travel Itinerary",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "retrieveTravelItinerary": {
                    "required": [
                      "partnerBid"
                    ],
                    "type": "object",
                    "properties": {
                      "toDate": {
                        "type": "string",
                        "description": "Date of Return for search criteria YYYY-MM-DD"
                      },
                      "userId": {
                        "maxLength": 19,
                        "minLength": 1,
                        "type": "string",
                        "description": "The User ID for which you want to retrieve travel itineraries."
                      },
                      "fromDate": {
                        "type": "string",
                        "description": "Date of travel departure for search criteria YYYY-MM-DD"
                      },
                      "partnerBid": {
                        "type": "string",
                        "description": "Your Visa Business Identifier (BID)."
                      },
                      "travelItineraryId": {
                        "type": "string",
                        "description": "The ID of the travel itinerary that you want to retrieve."
                      },
                      "primaryAccountNumber": {
                        "type": "object",
                        "properties": {
                          "cardAccountNumber": {
                            "maxLength": 19,
                            "minLength": 16,
                            "type": "string",
                            "description": "Card Account Number holds the numeric or Masked PAN and PAN should always be between 16 - 19 digits"
                          }
                        },
                        "description": "Card account number for which your cardholder has reported a travel plan."
                      }
                    },
                    "description": ""
                  }
                }
              },
              "examples": {
                "Default": {
                  "summary": "Default",
                  "value": {
                    "retrieveTravelItinerary": {
                      "fromDate": "2017-03-21",
                      "partnerBid": "10074101",
