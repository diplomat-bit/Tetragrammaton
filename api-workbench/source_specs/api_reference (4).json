  "components": {
    "schemas": {
      "UpdateTravelItineraryResponse": {
        "type": "object",
        "properties": {
          "failureCode": {
            "type": "string",
            "description": "Error code specific for CRUD operations"
          },
          "responseCode": {
            "type": "string",
            "description": "Web service response code"
          },
          "responseMessage": {
            "type": "string",
            "description": "service response text specific for CRUD operations"
          },
          "travelItinerary": {
            "$ref": "#/components/schemas/TravelItinerary"
          },
          "failureDescription": {
            "type": "string",
            "description": "Error description specific for CRUD operations"
          }
        },
        "description": "Itinenary from the System after Update Operations"
      },
      "Destination": {
        "required": [
          "country"
        ],
        "type": "object",
        "properties": {
          "state": {
            "pattern": "^([A-Z][A-Z])$",
            "type": "string",
            "description": "The state or province where your cardholder will travel. Must be a 2 character State Code for a state in the United States or a province in Canada and must not be included in the request if the Destination-Country is not the United States or Canada.A state in the United States must be included if the Destination – Country in the request is the United States. A province in Canada must be included if the Destination – Country in the request is Canada. If your cardholder will travel to multiple states or provinces, you can include multiple states or provinces in a single request."
          },
          "country": {
            "pattern": "^([0-9]{1,3})$",
            "type": "string",
            "description": "The country where your cardholder will travel. If your cardholder will travel to multiple countries, you can include multiple countries in a single request.Must be a 3 character country code, as specified in the ISO 3166-1."
          }
        }
      },
      "TravelItineraries": {
        "type": "array",
        "description": "List of travel itineraries based on the search criteria provided",
        "items": {
          "$ref": "#/components/schemas/TravelItinerary"
        }
      },
      "RegisterUserforTravelNotificationServiceResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "VDP User/application Id"
          },
          "partnerBid": {
            "pattern": "^([0-9]{8})$",
            "type": "string",
            "description": "The issuer BID associated with Itinerary"
          },
          "failureCode": {
            "type": "string",
            "description": "Error code specific for CRUD operations"
          },
          "responseCode": {
            "type": "string",
            "description": "Web service response code"
          },
          "responseMessage": {
            "type": "string",
            "description": "service response text specific for CRUD operations"
          },
          "failureDescription": {
            "type": "string",
            "description": "Error description specific for CRUD operations"
          }
        },
        "description": "Registration Information of a Developer for Travel Notification Service in VDP gateway"
      },
      "AddTravelItinerary": {
        "required": [
          "departureDate",
          "destinations",
          "partnerBid",
          "primaryAccountNumbers",
          "returnDate"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "User ID you assigned to identify the cardholder using the service."
          },
          "partnerBid": {
            "pattern": "^([0-9]{8})$",
            "type": "string",
            "description": "Your Visa Business Identifier (BID)."
          },
          "returnDate": {
            "pattern": "^([0-9]{4}-(0[1-9]{1}|1[0-2]{1})-(0[1-9]{1}|[1-2]{1}[0-9]{1}|3[0-1]{1}))$",
            "type": "string",
            "description": "The date your cardholder will return from the trip. Must be in format YYYY-MM-DD and must not be before the Departure Date in the request or before the current date."
          },
          "destinations": {
            "$ref": "#/components/schemas/Destinations"
          },
          "departureDate": {
            "pattern": "^([0-9]{4}-(0[1-9]{1}|1[0-2]{1})-(0[1-9]{1}|[1-2]{1}[0-9]{1}|3[0-1]{1}))$",
            "type": "string",
            "description": "The date your cardholder will start their trip. Must be in format YYYY-MM-DD and must not be after the Return Date in the request."
          },
          "primaryAccountNumbers": {
            "$ref": "#/components/schemas/PrimaryAccountNumbers"
          }
        },
        "description": "Adds an Itineray for the User"
      },
      "TravelItinerary": {
        "required": [
