{
  "entities": {
    "User": {
      "title": "User",
      "description": "Developer and user accounts with API credentials and role access.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "developer", "user"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role", "createdAt"]
    },
    "ApiKey": {
      "title": "ApiKey",
      "description": "Cryptographically secure API keys generated for external developers to invoke aibanking.dev endpoints.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "keyPrefix": { "type": "string" },
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "rateLimit": { "type": "number" },
        "totalCalls": { "type": "number" },
        "createdAt": { "type": "string" },
        "lastUsedAt": { "type": "string" }
      },
      "required": ["id", "key", "userId", "status", "createdAt"]
    },
    "ApiLog": {
      "title": "ApiLog",
      "description": "Real-time audit telemetry of incoming API requests, latency, status code, and endpoint provenance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "apiKeyId": { "type": "string" },
        "apiKeyPrefix": { "type": "string" },
        "userEmail": { "type": "string" },
        "endpoint": { "type": "string" },
        "method": { "type": "string" },
        "statusCode": { "type": "number" },
        "durationMs": { "type": "number" },
        "clientIp": { "type": "string" },
        "payloadSummary": { "type": "string" }
      },
      "required": ["id", "timestamp", "endpoint", "method", "statusCode"]
    },
    "StoredRecord": {
      "title": "StoredRecord",
      "description": "Persisted financial records, banking statements, Citi/Chase payloads, and QBO generated entities.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "apiKeyId": { "type": "string" },
        "accountGroup": { "type": "string" },
        "entityType": { "type": "string" },
        "payload": { "type": "object" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" },
        "provenance": { "type": "string" }
      },
      "required": ["id", "timestamp", "status"]
    },
    "UploadedApp": {
      "title": "UploadedApp",
      "description": "User uploaded ZIP applications with extracted sandbox files and execution metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "name": { "type": "string" },
        "filename": { "type": "string" },
        "fileSize": { "type": "number" },
        "fileCount": { "type": "number" },
        "entryPoint": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastTestedAt": { "type": "string" },
        "testSummary": { "type": "string" }
      },
      "required": ["id", "userId", "name", "filename", "entryPoint", "createdAt"]
    },
    "AiTestSession": {
      "title": "AiTestSession",
      "description": "Autonomous AI tester session logs, planned actions, execution results, and conversation history.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appId": { "type": "string" },
        "appName": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "actions": { "type": "array" },
        "feedback": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "running", "failed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "appId", "userId", "prompt", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account profiles"
    },
    "/api_keys/{keyId}": {
      "schema": "ApiKey",
      "description": "Developer API access keys"
    },
    "/api_logs/{logId}": {
      "schema": "ApiLog",
      "description": "Audit trails for API requests"
    },
    "/stored_records/{recordId}": {
      "schema": "StoredRecord",
      "description": "Ingested banking data and QBO synced entities"
    },
    "/uploaded_apps/{appId}": {
      "schema": "UploadedApp",
      "description": "User uploaded web apps from ZIP packages"
    },
    "/ai_test_sessions/{sessionId}": {
      "schema": "AiTestSession",
      "description": "Autonomous AI testing and interactive session logs"
    }
  }
}
