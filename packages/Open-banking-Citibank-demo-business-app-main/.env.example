# GEMINI_API_KEY: Required for Quantum Assistant AI Banking & Treasury copilot.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPEN BANK PROJECT (OBP) CREDENTIALS
# Set your registered consumer credentials below or in your deployment secrets.
# Do not share your Consumer Secret publicly.
OBP_CONSUMER_ID="your_consumer_id_here"
OBP_CONSUMER_KEY="your_consumer_key_here"
OBP_CONSUMER_SECRET="your_consumer_secret_here"

# Open Bank Project API endpoints (Default is the public OBP Sandbox)
OBP_API_BASE_URL="https://apisandbox.openbankproject.com"
OBP_DIRECT_LOGIN_ENDPOINT="https://apisandbox.openbankproject.com/my/logins/direct"
OBP_OAUTH_INITIATE_ENDPOINT="https://apisandbox.openbankproject.com/oauth/initiate"
OBP_USER_REDIRECT_URL="https://citibankdemobusiness.dev"

# MODERN TREASURY INTEGRATION (Optional)
MODERN_TREASURY_API_KEY=""
MODERN_TREASURY_ORG_ID=""

