# ==============================================================================
# CITI PARTNER API CONFIGURATION
# ==============================================================================

# CITI_BEARER_TOKEN: The OAuth 2.0 Authorization Bearer Token for Citi Partner API.
# e.g., Bearer AAIkOGJKVjVBdTdCODBMMHlVaG1tTmNDem5hVEpLVkNZS0np...
CITI_BEARER_TOKEN=""

# CITI_CLIENT_ID: Your registered Citi Developer Partner Client ID.
# Default sandbox client ID: 8bJV5Au7B80L0yUhmmNcCznaTJKVCYKI
CITI_CLIENT_ID="8bJV5Au7B80L0yUhmmNcCznaTJKVCYKI"

# CITI_UUID: Unique request identifier header for tracking API requests.
# Default sandbox UUID: fff161be-9ca1-4e25-8d83-e2191868d7e8
CITI_UUID="fff161be-9ca1-4e25-8d83-e2191868d7e8"

# CITI_API_URL: Target endpoint URL for Citi account details & real-time balances.
# Default: https://partner.citi.com/gcgapi/sandbox/prod/api/accounts/account-transactions/partner/v1/accounts/details
CITI_API_URL="https://partner.citi.com/gcgapi/sandbox/prod/api/accounts/account-transactions/partner/v1/accounts/details"

# CITI_TRANSACTIONS_URL: Target endpoint URL for Citi account transactions.
CITI_TRANSACTIONS_URL="https://partner.citi.com/gcgapi/sandbox/prod/api/accounts/account-transactions/partner/v1/transactions"

# CITI_ENVIRONMENT: Environment mode ("sandbox" or "production").
CITI_ENVIRONMENT="sandbox"

# AUTO_REFRESH_INTERVAL: Default balance polling interval in seconds (0 = off, 15, 30, 60).
AUTO_REFRESH_INTERVAL="0"

# ==============================================================================
# PLATFORM & AI CONFIGURATION
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default 3000).
PORT=3000
